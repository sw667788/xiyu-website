{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "excludeFiles": "{public/**,picture/**,dist/**,dist-ssr/**,node_modules/**,.trae/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/recharge", "destination": "/api/recharge" },
    { "source": "/recharge/", "destination": "/api/recharge" }
  ]
}
