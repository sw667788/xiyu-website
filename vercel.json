{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "excludeFiles": "{public/**,picture/**,dist/**,dist-ssr/**,node_modules/**,.trae/**,.git/**,scripts/**,.ssr-build/**}"
    }
  },
  "rewrites": [
    { "source": "/recharge", "destination": "/api/recharge" },
    { "source": "/recharge/", "destination": "/api/recharge" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
